# Copy to .env (never commit .env)
CORE_API_KEY=dev-change-me
DATABASE_URL=postgresql+psycopg://arjun:arjun@postgres:5432/arjun
MONGO_URL=mongodb://mongo:27017
# Self-hosted Evon (OpenAI-compatible). Leave empty to use the rule-based fallback parser.
EVON_BASE_URL=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# DEV ONLY, non-Gnani hosted LLM (CLAUDE.md open question 5: not cleared for demo/submission). Put the key
# here or in the shell, never in Git. Set EVON_SEND_TEMPLATE_KWARGS=0 for providers that reject vLLM fields.
EVON_API_KEY=
EVON_SEND_TEMPLATE_KWARGS=1
# Gnani API platform (Prisma STT / Timbre TTS) + LiveKit - voice-agent only
GNANI_API_KEY=your-gnani-api-key
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# voice-agent tuning (optional)
GNANI_STT_LANGUAGE=mr-IN
GNANI_USE_STREAMING=1
GNANI_TTS_VOICE=Pranav
GNANI_TTS_LANGUAGE=mr-IN
ARJUN_USER_ID=1
REASONING_URL=http://localhost:8001

# Household timezone for every service clock (containers run in UTC). Default Asia/Kolkata.
ARJUN_TZ=Asia/Kolkata
