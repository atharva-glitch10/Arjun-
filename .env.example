# Arjun: the ONE root .env. Copy to .env and fill in. Never commit .env; only this file is tracked.
# Every variable the project reads is listed here (names only, no real values).

# ---- Shared by core-api, reasoning, scheduler ----
# Shared secret for service-to-service calls to core-api. REQUIRED: core-api refuses to start if empty
# (only the test suites run without it, via ARJUN_TESTING=1). Use a long random string.
CORE_API_KEY=dev-change-me
# Where core-api is reachable from reasoning and scheduler. Use 127.0.0.1, not localhost: on Windows
# 'localhost' costs about 2 s per connection (IPv6 ::1 tried first, measured 2026-10-24).
CORE_API_URL=http://127.0.0.1:8000
# Where reasoning is reachable from voice-agent and scheduler.
REASONING_URL=http://127.0.0.1:8001
# Household timezone used by every service clock (containers run in UTC).
ARJUN_TZ=Asia/Kolkata

# ---- core-api storage ----
# SQLAlchemy URL for core-api. Defaults to sqlite:///./arjun.db when unset; compose uses Postgres.
DATABASE_URL=postgresql+psycopg://arjun:arjun@postgres:5432/arjun
# Reserved for MongoDB logs; not read by any service yet.
MONGO_URL=mongodb://mongo:27017

# ---- reasoning: the LLM for open conversation (leave LLM_BASE_URL and EVON_BASE_URL empty for rules only) ----
# Gnani = Prisma (hearing) + Timbre (voice). This LLM is a hosted, NON-Gnani provider when LLM_* is set; Evon
# is not used for the demo (decision T9, 2026-10-24). It is asked ONLY for companion/chat replies and for
# turns the rules cannot read (UNKNOWN). Reminders, times, medicines, confirmations and safety never wait
# for it. What the elder says in those turns IS SENT to this provider: use synthetic demo data only.
# Any OpenAI-compatible /chat/completions endpoint works. Base URL up to and including /v1.
LLM_BASE_URL=
# Model name sent to the provider (required when LLM_BASE_URL is set; never falls back to EVON_MODEL).
LLM_MODEL=
# Bearer key for the provider. Read only by the reasoning service. Never commit, never log.
LLM_API_KEY=
# Free-text provider name used in logs and /health, e.g. the company name.
LLM_PROVIDER_NAME=
# 0 for any provider that is not vLLM (drops the vLLM-only chat_template_kwargs field).
LLM_SEND_TEMPLATE_KWARGS=0
# One time budget in seconds for ALL LLM calls in a turn, then the fixed fallback line is used.
LLM_TIMEOUT_S=4
# Cap on reply length (tokens).
LLM_MAX_TOKENS=120
# How many past user/assistant exchanges of THIS conversation are sent.
LLM_HISTORY_EXCHANGES=4
# Old names, still honoured when LLM_BASE_URL is empty (Evon self-hosted via vLLM):
# Base URL of the OpenAI-compatible Evon server (vLLM / Friendli).
EVON_BASE_URL=
# Model name sent to the Evon server.
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# Bearer key for a hosted LLM. DEV ONLY, non-Gnani LLMs are not cleared for demo (CLAUDE.md open question 5).
EVON_API_KEY=
# 1 sends vLLM-only fields (chat_template_kwargs); set 0 for providers that reject them.
EVON_SEND_TEMPLATE_KWARGS=1

# ---- voice-agent: Gnani + LiveKit (secrets live only here, never in frontend code) ----
# Gnani API key for Prisma STT and Timbre TTS.
GNANI_API_KEY=
# LiveKit server URL, e.g. wss://<project>.livekit.cloud
LIVEKIT_URL=
# LiveKit API key (also used by core-api to sign elder tokens from T6).
LIVEKIT_API_KEY=
# LiveKit API secret (server-side only).
LIVEKIT_API_SECRET=
# STT language code; use "en-IN,hi-IN" for the plugin's code-mixed mode.
GNANI_STT_LANGUAGE=mr-IN
# 1 = streaming STT; 0 = non-streaming fallback (Marathi streaming support unconfirmed).
GNANI_USE_STREAMING=1
# Timbre TTS model. The API accepts only timbre-v2.5 and timbre-v3.0.
GNANI_TTS_MODEL=timbre-v2.5
# Timbre voice name (required by the API; Omkar verified with timbre-v2.5).
GNANI_TTS_VOICE=Omkar
# Timbre TTS language code.
GNANI_TTS_LANGUAGE=mr-IN
# Which synthetic user this voice-agent deployment serves.
ARJUN_USER_ID=1
# Agent name for EXPLICIT dispatch. scripts/make_token.py dispatches this name into the room.
ARJUN_AGENT_NAME=arjun
# Silence (seconds) before Arjun decides the user finished speaking. Placeholders: tune on elderly speech.
ARJUN_MIN_ENDPOINTING_S=1.0
ARJUN_MAX_ENDPOINTING_S=3.0
# Seconds the voice-agent waits for reasoning before speaking the fallback line.
REASONING_TIMEOUT_S=5

# ---- scheduler ----
# Seconds between scheduler ticks.
SCHEDULER_INTERVAL_SECONDS=30
# Comma-separated user ids that get daily openers (empty = none).
OPENER_USER_IDS=
# Comma-separated user ids that get morning briefings (falls back to OPENER_USER_IDS).
BRIEFING_USER_IDS=
