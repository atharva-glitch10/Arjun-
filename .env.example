# Arjun: the ONE root .env. Copy to .env and fill in. Never commit .env; only this file is tracked.
# Every variable the project reads is listed here (names only, no real values).

# ---- Shared by core-api, reasoning, scheduler ----
# Shared secret for service-to-service calls to core-api. REQUIRED: core-api refuses to start if empty
# (only the test suites run without it, via ARJUN_TESTING=1). Use a long random string.
CORE_API_KEY=dev-change-me
# Where core-api is reachable from reasoning and scheduler. Use 127.0.0.1, not localhost: on Windows
# 'localhost' costs about 2 s per connection (IPv6 ::1 tried first, measured 2026-10-24).
CORE_API_URL=http://127.0.0.1:8000
# Where reasoning is reachable from voice-agent and scheduler.
REASONING_URL=http://127.0.0.1:8001
ARJUN_LOGIC_EVAL_USER_ID=
# Household timezone used by every service clock (containers run in UTC).
ARJUN_TZ=Asia/Kolkata

# ---- core-api storage ----
# SQLAlchemy URL for core-api. Defaults to sqlite:///./arjun.db when unset; compose uses Postgres.
DATABASE_URL=postgresql+psycopg://arjun:arjun@postgres:5432/arjun
# Reserved for MongoDB logs; not read by any service yet.
MONGO_URL=mongodb://mongo:27017

# ---- family alerts over Telegram (free; no SMS provider) ----
# 1 = send a Telegram message for an emergency, a consented distress event and a "call me" request.
# 0 (default) = the family dashboard is the only alert. Read ONLY by core-api.
TELEGRAM_ENABLED=0
# Bot token from @BotFather. Never commit, never log (the request URL contains it).
TELEGRAM_BOT_TOKEN=
# Chat id of the family group or person. Never logged.
TELEGRAM_CHAT_ID=
# Public URL of the web app (e.g. the Cloudflare tunnel). Used to build the family-call join link.
# Empty = alerts are still sent, without a join button.
BASE_URL=
# Signs the 30-minute family-call join link. Empty = CORE_API_KEY is used.
JOIN_SECRET=

# ---- web: tunnel access lock (read ONLY by the Vite dev server, web/server/access.ts) ----
# The phone links carry this code (`/?user=1&k=<code>`); it is swapped for a 12 h HttpOnly cookie. Without a valid
# cookie the tunnel serves a Marathi "link does not work" page and the /core proxy adds NO API key. This laptop is
# always trusted. 6+ characters, letters/digits/dash; empty or shorter = every remote request is refused.
# `scripts\dev-up.ps1 -Phone` refuses to start the tunnel without it and prints the full links.
ARJUN_ACCESS_CODE=

# ---- reasoning: Sarvam (the simplest way to turn the LLM on) ----
# Setting SARVAM_API_KEY alone turns on Sarvam-105B for open conversation, the "unreadable turn" fallback and the
# family's conversation summaries. Hosted, NON-Gnani: what the elder says in those turns is sent to Sarvam.
SARVAM_API_KEY=
# sarvam-105b (flagship) or sarvam-105b-conversations (tuned for voice agents, 32K context). Default sarvam-105b.
SARVAM_MODEL=sarvam-105b
# Default https://api.sarvam.ai/v1 (OpenAI-compatible /chat/completions).
SARVAM_BASE_URL=
# Sarvam "thinks" before answering by default; that is latency in a voice turn, so it is OFF (reasoning_effort
# null) unless this is 1. Any <think>...</think> text is removed before anything is spoken or shown.
LLM_REASONING=0
# Concurrency + rate limit for LLM calls. Over either limit the rules answer at once (a voice turn never queues).
LLM_MAX_CONCURRENT=4
LLM_PER_MINUTE=60

# ---- reasoning: how Arjun acts ----
# 0 (default): no "... ठेवू का? हो किंवा नाही". Arjun acts at once, reads it back in one line, and "नको"/"चुकलं"
# within UNDO_WINDOW_S undoes it. Missing details (which day, what time) are still asked. 1 = the old yes/no flow.
ARJUN_ASK_BEFORE_ACTING=0

# Proactive day check-ins (core-api). The family also switches them on per person (daily_checkins).
# 1 = on, 0 = off for everyone. Routine care prompts are exempt from this daily cap.
ARJUN_CHECKINS_ENABLED=1
ARJUN_CHECKIN_MAX_PER_DAY=14
# Minimum minutes between two check-in questions.
ARJUN_CHECKIN_MIN_GAP_MIN=30
# 1 only for a live demo: lets scripts/checkin_demo.py ask the next check-in right now. Keep 0 otherwise.
ARJUN_CHECKIN_DEMO=0

UNDO_WINDOW_S=150
# Per-user limit on /turn (a stuck recognizer loop must not flood core-api or the LLM).
TURN_RATE_PER_S=2
TURN_RATE_BURST=6
# Seconds of silence that end a conversation; its summary (seriousness, mood, short paraphrase) then goes to
# the family dashboard. Mood and summaries are shown only with the "share how she is doing" consent.
CONVERSATION_IDLE_S=180

# ---- core-api: rate limit, undo, live feed ----
# Per-client HTTP rate limit (token bucket). 429 + Retry-After when exceeded. /health and WebSockets are exempt.
CORE_RATE_LIMIT=1
CORE_RATE_PER_S=30
CORE_RATE_BURST=60
# How long a just-done action can still be undone (core-api side; reasoning uses a shorter window).
UNDO_TTL_S=180
# The family feed WebSocket re-checks the table this often even without a push (rows from other processes).
FEED_RECHECK_S=5

# ---- reasoning: the LLM for open conversation (leave LLM_BASE_URL and EVON_BASE_URL empty for rules only) ----
# Gnani = Prisma (hearing) + Timbre (voice). This LLM is a hosted, NON-Gnani provider when LLM_* is set; Evon
# is not used for the demo (decision T9, 2026-10-24). It is asked ONLY for companion/chat replies and for
# turns the rules cannot read (UNKNOWN). Reminders, times, medicines, confirmations and safety never wait
# for it. What the elder says in those turns IS SENT to this provider: use synthetic demo data only.
# Any OpenAI-compatible /chat/completions endpoint works. Base URL up to and including /v1.
LLM_BASE_URL=
# Model name sent to the provider (required when LLM_BASE_URL is set; never falls back to EVON_MODEL).
LLM_MODEL=
# Bearer key for the provider. Read only by the reasoning service. Never commit, never log.
LLM_API_KEY=
# Free-text provider name used in logs and /health, e.g. the company name.
LLM_PROVIDER_NAME=
# 0 for any provider that is not vLLM (drops the vLLM-only chat_template_kwargs field).
LLM_SEND_TEMPLATE_KWARGS=0
# One time budget in seconds for ALL LLM calls in a turn, then the fixed fallback line is used.
LLM_TIMEOUT_S=6
# Cap on reply length (tokens).
LLM_MAX_TOKENS=80
# OLD knob, no longer the size of Arjun's memory (see ARJUN_SESSION_EXCHANGES below). Kept so old .env files load.
LLM_HISTORY_EXCHANGES=8
# ---- reasoning: session + long-term memory (services/reasoning/reasoning_svc/memory.py) ----
# Exchanges kept word for word in one person's history. Older turns are compressed into a 3-line summary, not deleted.
ARJUN_SESSION_EXCHANGES=20
# Minutes of silence after which the conversation counts as ended: its turns are COMPRESSED into the running summary
# (never deleted); a new conversation starts with that summary. After 24 h only the long-term facts remain.
ARJUN_SESSION_IDLE_MIN=30
# How many of her life facts (user_facts, core-api) go into each LLM call, best match for the sentence first.
ARJUN_FACTS_IN_CONTEXT=10
# Old names, still honoured when LLM_BASE_URL is empty (Evon self-hosted via vLLM):
# Base URL of the OpenAI-compatible Evon server (vLLM / Friendli).
EVON_BASE_URL=
# 1 = explicitly use configured EVON_* as primary reasoning provider; default 0 preserves existing provider order.
GNANI_REASONING_IMPL=off
# Model name sent to the Evon server.
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# Bearer key for a hosted LLM. DEV ONLY, non-Gnani LLMs are not cleared for demo (CLAUDE.md open question 5).
EVON_API_KEY=
# 1 sends vLLM-only fields (chat_template_kwargs); set 0 for providers that reject them.
EVON_SEND_TEMPLATE_KWARGS=1

# ---- voice-agent: Gnani + LiveKit (secrets live only here, never in frontend code) ----
# Gnani API key for Prisma STT and Timbre TTS.
GNANI_API_KEY=
# LiveKit server URL, e.g. wss://<project>.livekit.cloud
LIVEKIT_URL=
# LiveKit API key (also used by core-api to sign elder tokens from T6).
LIVEKIT_API_KEY=
# LiveKit API secret (server-side only).
LIVEKIT_API_SECRET=
# STT language hint supported by the pinned plugin. This is not automatic language identification.
GNANI_STT_LANGUAGE=mr-IN
# 1 = streaming STT; 0 = REST transcription fallback (Marathi streaming support unconfirmed).
GNANI_USE_STREAMING=1
GNANI_STT_IMPL=plugin
# Pinned plugin supports only verbatim/transcribe; v3 codemix/transliterate/Auto-LID are not exposed.
GNANI_STT_FORMAT=transcribe
# Plugin-supported streaming sample rate.
GNANI_STT_SAMPLE_RATE=16000
# With transcribe: write the digits in Devanagari (१० वाजता). Reasoning reads both digit forms.
GNANI_ITN_NATIVE_NUMERALS=true
# Timbre TTS model. timbre-v3.0 understands voice tags (<laugh>, <slow>, ...) that the LLM picks at runtime.
GNANI_TTS_MODEL=timbre-v3.0
# Voice for the model above. Avinash (male) is a timbre-v3.0 voice: UNVERIFIED on our key. The first synthesis of
# each worker is a probe; if it fails, the session uses the fallback below (verified live 2026-10-21).
GNANI_TTS_VOICE=Avinash
GNANI_TTS_FALLBACK_MODEL=timbre-v2.5
GNANI_TTS_FALLBACK_VOICE=Omkar
# sse (default): one pooled HTTP connection, sentence by sentence. websocket = the old path (new socket per reply).
GNANI_TTS_METHOD=sse
# Timbre TTS language code.
GNANI_TTS_LANGUAGE=mr-IN
# Opt in only after confirming the Timbre v3.0 multilingual voice catalog is enabled for this account.
GNANI_TTS_MULTILINGUAL_VOICE=0
# Consent-first voice cloning (core-api). Fernet key that encrypts stored speaker embeddings; empty = cloning off.
# Make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VOICE_CLONE_KEY=
# voice-agent: 0 = never speak in a cloned voice even if the family added one.
ARJUN_CLONED_VOICE=1
# voice-agent: how the cloned voice is fetched from Gnani: rest (default, clean audio) or sse (experimental: produced
# loud noise on the laptop 2026-11-08 and was not faster).
ARJUN_CLONED_VOICE_METHOD=rest
# voice-agent: languages the cloned voice may speak, e.g. hi,en (empty = all). Gnani's voice-clone API has no language
# field, so Marathi can sound Hindi-like; leave mr out to keep Marathi replies in Arjun's own Timbre voice.
ARJUN_CLONED_VOICE_LANGUAGES=
# Which synthetic user this voice-agent deployment serves.
ARJUN_USER_ID=1
# TESTING switch: gnani (default, the contest path) or sarvam (Saaras STT + Bulbul TTS, uses SARVAM_API_KEY).
# Never record or publish a demo with sarvam: the contest requires Gnani voice.
ARJUN_VOICE_PROVIDER=gnani
# ARJUN_SARVAM_SPEAKER=shubh
# Agent name for EXPLICIT dispatch. scripts/make_token.py dispatches this name into the room.
ARJUN_AGENT_NAME=arjun
# Silence (seconds) before Arjun decides the user finished speaking. Mode-aware since 2026-10-31 (placeholders: tune on
# elderly speech): commands/reminders use MIN 0.8 / CARE_MAX 2.5; chat and stories use COMPANION_MIN 1.6 / MAX 4.0. A sentence that
# ends in "आणि / पण / म्हणजे / की" is held for more speech for (max - min) seconds.
ARJUN_MIN_ENDPOINTING_S=0.8
ARJUN_CARE_MAX_ENDPOINTING_S=2.5
ARJUN_COMPANION_MIN_ENDPOINTING_S=1.6
ARJUN_MAX_ENDPOINTING_S=4.0
# vad (default) = silence after speech. auto = LiveKit's cloud turn detector (84 predictions, 4 timed out on 2026-10-31). stt = by transcript.
ARJUN_TURN_DETECTION=vad
# Hands-free: 0 (default) = the voice session never closes by itself; the elder just talks. 60 = the old idle
# close after 60 s (saves recognition credits; then a tap opens a new session). Credit cost of always-on: unmeasured.
ARJUN_IDLE_CLOSE_S=0
# Seconds the voice-agent waits for reasoning before speaking the fallback line.
REASONING_TIMEOUT_S=7.5
# Shared, read-only turn timing source for the family's numeric performance card.
ARJUN_VOICE_TURNLOG_PATH=eval/results/turns.jsonl
# Enable account, family-session and paired-device authorization after setting up Phase 1 accounts.
ARJUN_AUTH=0
# Experimental non-speech sound events are disabled by default. Enable only with a local YAMNet ONNX file.
ARJUN_SOUND_EVENTS=0
ARJUN_SOUND_MODEL_PATH=

# ---- voice-controlled apps (read ONLY by core-api; never in React code) ----
# YouTube Data API v3 key for search (search.list costs 100 of the 10,000 daily units; results are cached 24 h).
# Empty = the elder screen opens the YouTube results page instead of playing the first match.
YOUTUBE_API_KEY=
# Cap on UNCACHED searches per day (80 x 100 = 8,000 units).
YOUTUBE_MAX_SEARCHES_PER_DAY=80

# ---- scheduler ----
# Seconds between scheduler ticks.
SCHEDULER_INTERVAL_SECONDS=30
# Send each opted-in user's Marathi Telegram voice briefing once a day at this household-local time.
BRIEFING_TIME=20:30
# Private loopback endpoint hosted by the voice-agent; the Gnani API key stays in that process.
BRIEFING_VOICE_URL=http://127.0.0.1:8002/synthesize
# Comma-separated user ids that get daily openers (empty = every user with daily_checkins=True).
OPENER_USER_IDS=

# voice-agent, Prisma v3 only (GNANI_STT_IMPL=v3): language hints (max 4). Empty = the elder's languages + hi-IN + en-IN
# (so Hinglish is recognised as Hindi, not Marathi). "auto" = Gnani indic-auto.
GNANI_STT_LANGUAGE_HINTS=
